# Required. The app refuses to start without it.
ANTHROPIC_API_KEY=sk-ant-...

# Model and provider. Defaults come from config/default.toml.
# DECKPAGER_PROVIDER=anthropic
# DECKPAGER_MODEL=claude-opus-5
# DECKPAGER_EFFORT=high
# DECKPAGER_MAX_TOKENS=32000

# Ingestion limits.
# DECKPAGER_MAX_SLIDES=60
# DECKPAGER_MAX_IMAGE_BYTES=5000000
# DECKPAGER_NO_IMAGES=false

