# Required. The app refuses to start without it.
ANTHROPIC_API_KEY=sk-ant-...

# Model and provider. Defaults come from config/default.toml.
# PITCHLENS_PROVIDER=anthropic
# PITCHLENS_MODEL=claude-opus-5
# PITCHLENS_EFFORT=high
# PITCHLENS_MAX_TOKENS=32000

# Ingestion limits.
# PITCHLENS_MAX_SLIDES=60
# PITCHLENS_MAX_IMAGE_BYTES=5000000
# PITCHLENS_NO_IMAGES=false

# --- Web app (app.py) -------------------------------------------------------
# Set APP_PASSWORD to put the whole app behind HTTP Basic. LEFT UNSET, THE APP IS
# OPEN: anyone with the URL can upload a deck and spend the API key above.
# APP_PASSWORD=
# APP_USERNAME=ten

# MAX_CONCURRENT_JOBS=2
# JOB_TTL_MINUTES=180
# MAX_UPLOAD_MB=25

# --- Emailing a copy of every one-pager ------------------------------------
# REPORT_EMAIL_TO switches the feature on. Leave it unset and nothing is emailed;
# the upload page's disclosure is generated from these values, so the page always
# states what the server actually does.
#
# Note what this means before enabling it: every founder's deck analysis leaves your
# infrastructure to the mailbox below, and the uploaded deck is usually confidential.
# REPORT_EMAIL_TO=
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_FROM=reports@tencapital.group
# SMTP_USER=
# SMTP_PASSWORD=          # Gmail requires an App Password, not the account password
# SMTP_TLS=true
